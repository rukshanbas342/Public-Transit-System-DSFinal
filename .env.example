# Copy to .env and edit. Every value has a default in docker-compose.yml,
# so the stack runs without a .env file at all.

# --- simulation (most common things to change between test runs) -----------
SIM_SCENARIO=baseline        # any file in config/scenarios: baseline | rush_hour | breakdown | quick_test
SIM_SEED=42                  # same seed => same passenger arrivals
SIM_SPEED=1.0                # real seconds per simulated minute (0 = as fast as possible)
SIM_SET=                     # extra overrides, ';'-separated, e.g. fleet.capacity=60;fleet.size=14

# --- scheduler ---------------------------------------------------------------
AUTO_APPROVE=false           # true for experiment runs

# --- credentials -------------------------------------------------------------
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit
POSTGRES_DB=transit
RABBITMQ_USER=transit
RABBITMQ_PASSWORD=transit
OPERATOR_USERNAME=operator   # dashboard login, created by the seed step
OPERATOR_PASSWORD=operator
API_SECRET_KEY=change-me

# --- host ports (change if something on your machine already uses them) -----
API_PORT=8000                # dashboard + API
RABBITMQ_UI_PORT=15672       # RabbitMQ management UI
POSTGRES_PORT=5432           # only with docker-compose.dev.yml
RABBITMQ_PORT=5672           # only with docker-compose.dev.yml

LOG_LEVEL=INFO
